# Example Environment Configuration (Public Template)
# Copy this file to .env and customize with your own parameters:
# cp .env.example .env

# Academic Calendar Feed (iCal / WebCal URL)
ICAL_FEED_URL="https://example.university.edu/calendar/feed?token=YOUR_AUTH_TOKEN"
# Optional production allowlist (comma-separated hostnames, no scheme)
ICAL_ALLOWED_HOSTS="example.university.edu"

# Supabase authentication (the anon key is public client configuration, not a service-role key)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# Optional shared production origin for native API calls, OAuth redirects, and API CORS
VITE_APP_ORIGIN="https://your-app.example.com"
APP_ORIGIN="https://your-app.example.com"

# Browser/native origins allowed to call the API in addition to the built-in app origins
ALLOWED_ORIGINS="https://your-app.example.com"

# Location Configuration for Automated Transit Calculations
VITE_HOME_ADDRESS="123 Main Street, City, State, Country"
VITE_CAMPUS_ADDRESS="456 University Boulevard, City, State, Country"
VITE_TRAIL_LOCATION="Mountain Trail Park"
VITE_TRAIL_ADDRESS="Mountain Trail Park, City, State, Country"

# Target Race / Goal Settings
VITE_TARGET_RACE_NAME="Ultra-Trail 80 km"
VITE_TARGET_RACE_DATE="2027-07-03"
VITE_PLAN_START_DATE="2027-01-11"
VITE_SPORT_START_DATE="2026-09-01"

# Athlete Profile
VITE_ATHLETE_FC_MAX=203
VITE_ATHLETE_FC_REST=48

# Garmin credentials are entered at runtime and remain session-only.
